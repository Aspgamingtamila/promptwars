# Optional Supabase scaffolding; the current demo UI does not use this backend.
# The anon key is public and must only be used with correctly configured RLS.
# Never put a service_role key or other private credential in a VITE_* variable.

VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
